---
interface Props {
  /** Render as a typed command line with a prompt, rather than output */
  cmd?: boolean;
  /** Render dimmed, as a shell comment */
  comment?: boolean;
  /** Show a blinking cursor at the end of the line */
  cursor?: boolean;
}

const { cmd = false, comment = false, cursor = false } = Astro.props;
---

<p class:list={['line', { 'line--comment': comment }]}>
  {
    cmd && (
      <>
        <span class="prompt" aria-hidden="true">
          qilmeg@qilmegd
        </span>
        <span class="path" aria-hidden="true">
          :~
        </span>
        <span class="sigil" aria-hidden="true">
          ${' '}
        </span>
      </>
    )
  }<slot />{cursor && <span class="cursor" aria-hidden="true"></span>}
</p>

<style>
  .line {
    margin: 0 0 0.15em;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .line--comment {
    color: var(--term-comment);
  }

  .prompt {
    color: var(--term-prompt);
    font-weight: 600;
  }

  .path {
    color: var(--term-path);
  }

  .sigil {
    color: var(--fg-muted);
  }

  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.05em;
    margin-left: 0.15em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
